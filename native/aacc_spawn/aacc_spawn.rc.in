#include <windows.h>

1 VERSIONINFO
 FILEVERSION @VERSION_COMMA@
 PRODUCTVERSION @VERSION_COMMA@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "AACC contributors"
            VALUE "FileDescription", "AACC fixed-purpose Codex spawn broker"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "aacc-spawn"
            VALUE "OriginalFilename", "aacc-spawn.exe"
            VALUE "ProductName", "AI Agent Control Center"
            VALUE "ProductVersion", "@VERSION@"
            VALUE "ProtocolVersion", "1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
